    "medium-zoom": "^1.1.0",
    "mermaid": "^11.17.0",
    "vitepress": "^1.5.0",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12"
