function TSvgPatternNode.DumpNode(Indent: Integer): string;
var
  patUnitsStr, contentUnitsStr: string;
begin
  Result := inherited DumpNode(Indent);
  case FPatternUnits of
    guUserSpaceOnUse: patUnitsStr := 'guUserSpaceOnUse';
