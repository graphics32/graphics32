constructor TSvgFeColorMatrixNode.Create(AParent: TSvgNode);
begin
  inherited Create(AParent);
  FMatrixType := cmMatrix;
  FValues := nil;
end;

function TSvgFeColorMatrixNode.Clone(AParent: TSvgNode): TSvgNode;
var
  cmRes: TSvgFeColorMatrixNode;
begin
  cmRes := TSvgFeColorMatrixNode(inherited Clone(AParent));
  cmRes.FMatrixType := FMatrixType;
  cmRes.FValues := Copy(FValues, 0, Length(FValues));
  Result := cmRes;
end;

procedure TSvgFeColorMatrixNode.ParseAttribute(AKeyword: TSvgAttributeKeyword; const AValue: TValuePUtf8Char);
var
  Value, Values: TValuePUtf8Char;
  i: Integer;
begin
  case AKeyword of
    attrType:
      FMatrixType := ParseSvgFeColorMatrixType(AValue);

    attrValues:
      begin
        Values := AValue;
        Values.Trim;
        i := 0;
        while (Values.Len > 0) do
        begin
          Value := Values.Split(sListSeparators, True);

          if (Value.Len = 0) then
            break;

          if (i > High(FValues)) then
            SetLength(FValues, i + 20);

          if (not Value.TryToFloat(FValues[i])) then
            break;
          Inc(i);
        end;
        SetLength(FValues, i);
      end;
  else
    inherited ParseAttribute(AKeyword, AValue);
  end;
end;

function TSvgFeColorMatrixNode.DumpNode(Indent: Integer): string;
begin
  Result := inherited DumpNode(Indent) + Format(' (type=%s)', [FeColorMatrixTypeToString(FMatrixType)]);
end;


